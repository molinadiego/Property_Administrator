generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (docs/especificacion/etapa-1.md §2)
// ---------------------------------------------------------------------------

enum UserStatus {
  active
}

enum CompanyType {
  property_management
  contractor
  profesional
  own_business
}

enum MembershipRole {
  owner
  member
}

enum MembershipStatus {
  active
  revoked
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ActorType {
  user
  system
}

// ---------------------------------------------------------------------------
// Etapa 2 enums (docs/especificacion/etapa-2.md §2.10)
// ---------------------------------------------------------------------------

enum PropertyOccupancy {
  occupied
  vacant
}

enum PropertyTenantKind {
  owner
  tenant
}

enum OrderOrigin {
  management
  contractor
  own_business
}

enum OrderStatus {
  requested
  open
  in_progress
  completed
  cancelled
}

enum JobStatus {
  pending
  accepted
  in_progress
  incomplete
  done
  not_realized
}

enum AssignmentStatus {
  pending
  accepted
  rejected
  revoked
}

enum JobEventType {
  progress_note
  started
  completed
  incomplete
  resumed
  not_realized
}

enum FileKind {
  photo
  document
}

enum FileTargetType {
  order
  job
}

enum NotificationType {
  order_created
  order_assigned
  assignment_requested
  assignment_accepted
  assignment_rejected
  job_added
  // Etapa 6 (docs/especificacion/etapa-6.md §2.7): urgencias §18.4
  urgent_reminder
  urgent_escalated
}

// ---------------------------------------------------------------------------
// Etapa 6 enums (docs/especificacion/etapa-6.md §2)
// ---------------------------------------------------------------------------

enum WarrantyClaimStatus {
  open
  resolved
}

enum PlanCategory {
  profesional
  contractor
  property_management
}

enum LimitedAccessStatus {
  active
  revoked
  expired
}

// ---------------------------------------------------------------------------
// Etapa 4 enums (docs/especificacion/etapa-4.md §2.1)
// ---------------------------------------------------------------------------

enum EmergencyPolicy {
  prior_authorization
  resolve_without_authorization
  emergency_amount
}

enum CostCategory {
  material
  labor
  other
}

enum CostReportStatus {
  draft
  submitted
}

enum AuthorizationRequestType {
  exceed_spending_limit
  additional_work
}

enum AuthorizationRequestStatus {
  pending
  approved
  rejected
}

enum AuthorizationSource {
  platform_request
  offline
}

// ---------------------------------------------------------------------------
// Etapa 5 enums (docs/especificacion/etapa-5.md §2.1)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  voided
}

enum InvoiceLineKind {
  material
  labor
  tool_rental
  travel
  other
}

enum PaymentKind {
  charge
  refund
}

enum PaymentStatus {
  recorded
  duplicate_suspect
  duplicate_confirmed
}

enum PaymentMethod {
  cash
  check
  transfer
  card
  other
}

// ---------------------------------------------------------------------------
// Identity tables (no company_id: a person belongs to several companies)
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  phone        String?
  locale       String     @default("es")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  memberships                Membership[]
  membershipsInvited         Membership[]           @relation("MembershipInvitedBy")
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  companiesCreated           Company[]              @relation("CompanyCreatedBy")
  invitationsSent            Invitation[]           @relation("InvitationSentBy")
  invitationsAccepted        Invitation[]           @relation("InvitationAcceptedBy")
  auditEntries               AuditLog[]             @relation("AuditActor")
  propertiesCreated          Property[]             @relation("PropertyCreatedBy")
  ordersOriginated           Order[]                @relation("OrderOriginator")
  assignmentsCreatedBy       Assignment[]           @relation("AssignmentCreatedBy")
  notifications              Notification[]
  jobEvents                  JobEvent[]             @relation("JobEventActor")
  filesUploaded              FileObject[]           @relation("FileUploadedBy")
  historySharesCreated       HistoryShare[]         @relation("HistoryShareCreatedBy")
  ordersClosed               Order[]                @relation("OrderClosedBy")
  ordersCancelled            Order[]                @relation("OrderCancelledBy")
  // Etapa 6 (docs/especificacion/etapa-6.md §2.6)
  notificationPreferences    NotificationPreference[]
  warrantyClaimsResolved     WarrantyClaim[]        @relation("WarrantyClaimResolvedBy")
  warrantyClaimsCreated      WarrantyClaim[]        @relation("WarrantyClaimCreatedBy")
  // Etapa 4 (docs/especificacion/etapa-4.md §2)
  commercialRelationsCreated CommercialRelation[]   @relation("CommercialRelationCreatedBy")
  costReportsSubmitted       CostReport[]           @relation("CostReportSubmittedBy")
  authorizationsGranted      OrderAuthorization[]   @relation("OrderAuthorizationGrantedBy")
  authorizationsRegistered   OrderAuthorization[]   @relation("OrderAuthorizationAuthorizedBy")
  authRequestsCreated        AuthorizationRequest[] @relation("AuthRequestRequestedBy")
  authRequestsResolved       AuthorizationRequest[] @relation("AuthRequestResolvedBy")
  // Etapa 5 (docs/especificacion/etapa-5.md §2.2, §2.4)
  invoicesVoided             Invoice[]              @relation("InvoiceVoidedBy")
  invoicesCreated            Invoice[]              @relation("InvoiceCreatedBy")
  paymentsCreated            Payment[]              @relation("PaymentCreatedBy")
  paymentsReconciled         Payment[]              @relation("PaymentReconciledBy")

  @@map("users")
}

model Company {
  id                   String          @id @default(uuid()) @db.Uuid
  name                 String
  type                 CompanyType
  createdBy            String          @map("created_by") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz()
  /// General spending-limit policy (spec etapa-4 §2.2, §8.4): null = «sin
  /// límite económico». Applied by default when a new order doesn't set one.
  defaultSpendingLimit Decimal?        @map("default_spending_limit") @db.Decimal(12, 2)
  /// General emergency policy (§8.6); orders can be governed by a commercial
  /// relation that overrides it.
  emergencyPolicy      EmergencyPolicy @default(prior_authorization) @map("emergency_policy")
  /// Pre-authorized emergency amount for the `emergency_amount` policy (§8.6).
  emergencyExtraAmount Decimal?        @map("emergency_extra_amount") @db.Decimal(12, 2)
  /// Etapa 6: response window for urgent orders received from other
  /// companies (§14.2, §18.4); default 24h, owner-editable (etapa-6.md §2.4).
  urgentResponseHours Int              @default(24) @map("urgent_response_hours")
  /// Etapa 6: explicit subscription plan (§15); null = plan by company
  /// category (etapa-6.md §2.4, D3).
  planId              String?          @map("plan_id") @db.Uuid
  /// Etapa 7 (spec etapa-7.md §2.1, proyect.md §11.6): fiscal profile.
  /// Fictitious in seeds; edited only by the company's highest role (D5).
  taxId               String?          @map("tax_id") @db.VarChar(64)
  taxAddress          String?          @map("tax_address") @db.Text
  /// Default sales-tax rate in percent (0–100, ≤ 3 decimals, Nevada 6.85–8.375).
  defaultTaxRate      Decimal?         @map("default_tax_rate") @db.Decimal(5, 3)
  /// Exempt issuers freeze tax_total = 0.00 at emission (etapa-7.md D2).
  taxExempt           Boolean          @default(false) @map("tax_exempt")

  createdByUser             User                   @relation("CompanyCreatedBy", fields: [createdBy], references: [id])
  plan                      Plan?                  @relation(fields: [planId], references: [id])
  memberships               Membership[]
  invitations               Invitation[]
  auditEntries              AuditLog[]             @relation("AuditCompany")
  properties                Property[]
  clientRelationships       ClientRelationship[]
  orders                    Order[]
  jobs                      Job[]
  assignments               Assignment[]
  notifications             Notification[]
  jobEvents                 JobEvent[]
  fileObjects               FileObject[]
  historyShares             HistoryShare[]
  // Etapa 4 (docs/especificacion/etapa-4.md §2.2, §2.4)
  commercialRelations       CommercialRelation[]   @relation("CommercialRelationOwner")
  counterpartyRelations     CommercialRelation[]   @relation("CommercialRelationCounterparty")
  costReports               CostReport[]
  authorizationRequestsSent AuthorizationRequest[] @relation("AuthRequestCompany")
  // Etapa 5 (docs/especificacion/etapa-5.md §2.2, §2.4, §2.5)
  invoicesIssued            Invoice[]              @relation("InvoiceIssuer")
  invoicesReceived          Invoice[]              @relation("InvoiceRecipientCompany")
  paymentsRegistered        Payment[]              @relation("PaymentCompany")
  invoiceCounter            InvoiceCounter?
  // Etapa 6 (docs/especificacion/etapa-6.md §2)
  warrantyClaims            WarrantyClaim[]

  @@map("companies")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(active)
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz()

  company       Company        @relation(fields: [companyId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  invitedByUser User?          @relation("MembershipInvitedBy", fields: [invitedBy], references: [id])
  assignments   Assignment[]
  historyShares HistoryShare[] @relation("HistoryShareRecipient")

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  email      String
  role       MembershipRole
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(pending)
  invitedBy  String           @map("invited_by") @db.Uuid
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz()
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz()
  acceptedBy String?          @map("accepted_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  company        Company @relation(fields: [companyId], references: [id])
  invitedByUser  User    @relation("InvitationSentBy", fields: [invitedBy], references: [id])
  acceptedByUser User?   @relation("InvitationAcceptedBy", fields: [acceptedBy], references: [id])

  @@index([companyId, status])
  @@map("invitations")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  ip         String?
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Append-only: the application role has no UPDATE/DELETE grants on this
// table (enforced in migration etapa1_audit_grants, spec §2.6 / test #23).
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  payload     Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  company   Company? @relation("AuditCompany", fields: [companyId], references: [id])
  actorUser User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Etapa 2: propiedades, inquilinos, órdenes, trabajos, asignaciones,
// notificaciones y acceso limitado (docs/especificacion/etapa-2.md §2)
// ---------------------------------------------------------------------------

model Property {
  id                   String            @id @default(uuid()) @db.Uuid
  companyId            String            @map("company_id") @db.Uuid
  ownerName            String?           @map("owner_name")
  ownerPhone           String?           @map("owner_phone")
  ownerEmail           String?           @map("owner_email")
  ownerAddress         String?           @map("owner_address")
  ownerCity            String?           @map("owner_city")
  ownerState           String?           @map("owner_state")
  ownerPostalCode      String?           @map("owner_postal_code")
  addressLine          String            @map("address_line")
  city                 String
  state                String
  postalCode           String?           @map("postal_code")
  occupancy            PropertyOccupancy @default(vacant)
  communityName        String?           @map("community_name")
  communityAccessCode  String?           @map("community_access_code")
  entryInstructions    String?           @map("entry_instructions")
  allowUnattendedEntry Boolean           @default(false) @map("allow_unattended_entry")
  petsInfo             String?           @map("pets_info")
  otherInstructions    String?           @map("other_instructions")
  createdBy            String            @map("created_by") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  company         Company          @relation(fields: [companyId], references: [id])
  createdByUser   User             @relation("PropertyCreatedBy", fields: [createdBy], references: [id])
  propertyTenants PropertyTenant[]
  orders          Order[]
  historyShares   HistoryShare[]

  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("properties")
}

/// Cuenta con acceso limitado (spec §2.3): no inicia sesión con credencial
/// propia; accede mediante un token opaco revocable (LimitedAccessToken).
model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// Delivery channel for the limited-access token (spec etapa-2 §3, approved
  /// decision). Not part of §4.3's operational fields; optional.
  email        String?  @unique
  phones       Json     @default("[]")
  address      String?
  availability String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  propertyTenants     PropertyTenant[]
  clientRelationships ClientRelationship[]
  accessTokens        LimitedAccessToken[]
  requests            Order[]              @relation("TenantRequestedOrder")
  // Etapa 5: facturas emitidas a este cliente propio (decisión P3, §2.2)
  invoicesReceived    Invoice[]            @relation("InvoiceRecipientTenant")

  @@map("tenants")
}

model PropertyTenant {
  id         String             @id @default(uuid()) @db.Uuid
  propertyId String             @map("property_id") @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  kind       PropertyTenantKind
  createdBy  String             @map("created_by") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([propertyId, tenantId])
  @@index([propertyId])
  @@index([tenantId])
  @@map("property_tenants")
}

model ClientRelationship {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  company Company @relation(fields: [companyId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  orders              Order[]
  commercialRelations CommercialRelation[]

  @@unique([companyId, tenantId])
  @@index([companyId])
  @@index([tenantId])
  @@map("client_relationships")
}

model Order {
  id                      String      @id @default(uuid()) @db.Uuid
  companyId               String      @map("company_id") @db.Uuid
  propertyId              String      @map("property_id") @db.Uuid
  title                   String
  description             String
  origin                  OrderOrigin
  /// Creator of the order; null while it's still a `requested` order placed by
  /// a limited-access account (assigned on conversion, spec §5.1 / AC-4.5).
  originatorId            String?     @map("originator_id") @db.Uuid
  clientRelationshipId    String?     @map("client_relationship_id") @db.Uuid
  requestedByTenantId     String?     @map("requested_by_tenant_id") @db.Uuid
  parentOrderId           String?     @map("parent_order_id") @db.Uuid
  accessLockbox           String?     @map("access_lockbox")
  accessCommunityCode     String?     @map("access_community_code")
  accessEntryInstructions String?     @map("access_entry_instructions")
  status                  OrderStatus @default(open)
  /// Etapa 6: urgent flag (§14.2); only editable while the order is active
  /// (spec etapa-6.md §2.2).
  urgent                  Boolean     @default(false)
  closedBy                String?     @map("closed_by") @db.Uuid
  closedAt                DateTime?   @map("closed_at") @db.Timestamptz()
  cancelledBy             String?     @map("cancelled_by") @db.Uuid
  cancelledAt             DateTime?   @map("cancelled_at") @db.Timestamptz()
  cancellationReason      String?     @map("cancellation_reason")
  // Etapa 4: política económica de la orden (spec etapa-4 §2.3, §8.4–§8.6)
  /// null = «sin límite económico» (§8.4). `spending_limit_set_at` marks an
  /// explicit decision — including creation (any path) and an explicit null
  /// («sin límite», matrix #36); only untouched orders inherit the company
  /// default in the economic summary.
  spendingLimit           Decimal?    @map("spending_limit") @db.Decimal(12, 2)
  spendingLimitSetBy      String?     @map("spending_limit_set_by") @db.Uuid
  spendingLimitSetAt      DateTime?   @map("spending_limit_set_at") @db.Timestamptz()
  /// Commercial margin up to 20 %, enabled explicitly (§8.5). Private to the
  /// originating company; never raises the authorized spending ceiling.
  marginEnabled           Boolean     @default(false) @map("margin_enabled")
  marginPercent           Decimal?    @map("margin_percent") @db.Decimal(5, 2)
  marginSetBy             String?     @map("margin_set_by") @db.Uuid
  marginSetAt             DateTime?   @map("margin_set_at") @db.Timestamptz()
  /// Commercial relation governing this order's emergency policy (§8.6).
  commercialRelationId    String?     @map("commercial_relation_id") @db.Uuid
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  company               Company                @relation(fields: [companyId], references: [id])
  property              Property               @relation(fields: [propertyId], references: [id])
  originatorUser        User?                  @relation("OrderOriginator", fields: [originatorId], references: [id])
  clientRelationship    ClientRelationship?    @relation(fields: [clientRelationshipId], references: [id])
  commercialRelation    CommercialRelation?    @relation(fields: [commercialRelationId], references: [id])
  requestedByTenant     Tenant?                @relation("TenantRequestedOrder", fields: [requestedByTenantId], references: [id])
  parentOrder           Order?                 @relation("OrderHierarchy", fields: [parentOrderId], references: [id])
  childOrders           Order[]                @relation("OrderHierarchy")
  jobs                  Job[]
  files                 FileObject[]
  closedByUser          User?                  @relation("OrderClosedBy", fields: [closedBy], references: [id])
  cancelledByUser       User?                  @relation("OrderCancelledBy", fields: [cancelledBy], references: [id])
  orderAuthorizations   OrderAuthorization[]
  authorizationRequests AuthorizationRequest[]
  // Etapa 5: una factura siempre es de una sola orden (v1, §11.1 / D8)
  invoices              Invoice[]
  // Etapa 6: reclamos de garantía sobre un trabajo de esta orden (§13)
  warrantyClaims        WarrantyClaim[]

  @@index([companyId, createdAt])
  @@index([propertyId])
  @@index([parentOrderId])
  @@map("orders")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  title       String
  description String
  sortOrder   Int       @map("sort_order")
  status      JobStatus @default(pending)
  /// First time the work began (`start`). Never cleared: it is the "work was
  /// performed" marker that decides order cancellation (spec etapa-3 §2.2).
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  order          Order                @relation(fields: [orderId], references: [id])
  company        Company              @relation(fields: [companyId], references: [id])
  assignments    Assignment[]
  jobEvents      JobEvent[]
  authorizations OrderAuthorization[]
  // Etapa 5: cada renglón de factura referencia el trabajo (§11.1)
  invoiceLines   InvoiceLine[]
  // Etapa 6: reclamos de garantía sobre este trabajo reparado (§13)
  warrantyClaims WarrantyClaim[]

  @@unique([orderId, sortOrder])
  @@index([orderId])
  @@index([orderId, status])
  @@index([companyId])
  @@map("jobs")
}

model Assignment {
  id                   String           @id @default(uuid()) @db.Uuid
  jobId                String           @map("job_id") @db.Uuid
  companyId            String           @map("company_id") @db.Uuid
  assigneeMembershipId String           @map("assignee_membership_id") @db.Uuid
  status               AssignmentStatus @default(pending)
  assignedBy           String           @map("assigned_by") @db.Uuid
  respondedAt          DateTime?        @map("responded_at") @db.Timestamptz()
  rejectionReason      String?          @map("rejection_reason")
  /// Etapa 6: urgency-window sweep marks for urgent orders (spec etapa-6.md
  /// §2.3); idempotency markers, never cleared.
  urgencyReminderAt    DateTime?        @map("urgency_reminder_at") @db.Timestamptz()
  urgencyEscalatedAt   DateTime?        @map("urgency_escalated_at") @db.Timestamptz()
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  job                Job          @relation(fields: [jobId], references: [id])
  company            Company      @relation(fields: [companyId], references: [id])
  assigneeMembership Membership   @relation(fields: [assigneeMembershipId], references: [id])
  assignedByUser     User         @relation("AssignmentCreatedBy", fields: [assignedBy], references: [id])
  costReports        CostReport[]

  @@index([jobId])
  @@index([companyId])
  @@index([assigneeMembershipId])
  @@map("assignments")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  entityType String           @map("entity_type")
  entityId   String           @map("entity_id") @db.Uuid
  link       String?
  readAt     DateTime?        @map("read_at") @db.Timestamptz()
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Token opaco de acceso limitado (spec etapa-2 §3, decisión aprobada
/// 17/10/2026): solo se guarda su hash; se entrega por correo al vincular
/// la cuenta. Revocable y con expiración.
model LimitedAccessToken {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  tokenHash String              @unique @map("token_hash")
  status    LimitedAccessStatus @default(active)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz()
  revokedAt DateTime?           @map("revoked_at") @db.Timestamptz()
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("limited_access_tokens")
}

// ---------------------------------------------------------------------------
// Etapa 3: job events (tracking), file objects (photos/documents) and history
// shares (docs/especificacion/etapa-3.md §2.5–§2.8)
// ---------------------------------------------------------------------------

// Append-only: the application role has no UPDATE/DELETE grants on this table
// (grants in the etapa3 migration, spec §2.5 / matriz #49). Reasons and free
// progress notes live here, not on the job row, because they can repeat
// (incomplete → in_progress → incomplete).
model JobEvent {
  id          String       @id @default(uuid()) @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  type        JobEventType
  /// Free text: required for progress_note, incomplete and not_realized
  /// (422 when missing), optional otherwise. Max 2000 chars (spec §2.5).
  message     String?
  actorUserId String?      @map("actor_user_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  job       Job     @relation(fields: [jobId], references: [id])
  company   Company @relation(fields: [companyId], references: [id])
  actorUser User?   @relation("JobEventActor", fields: [actorUserId], references: [id])

  @@index([jobId, createdAt])
  @@index([companyId])
  @@map("job_events")
}

/// Photographs and documents (spec §2.6). Bytes live outside Postgres (in the
/// `StorageService`); this row is metadata + permissions.
model FileObject {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  /// Every file belongs to an order even when its target is a job (spec §2.6).
  orderId     String         @map("order_id") @db.Uuid
  targetType  FileTargetType @map("target_type")
  targetId    String         @map("target_id") @db.Uuid
  kind        FileKind
  /// Original name, sanitized; never echoed into audit payloads or logs.
  filename    String
  contentType String         @map("content_type")
  sizeBytes   Int            @map("size_bytes")
  /// Key in the object storage; the storage key is a generated UUID.
  storageKey  String         @unique @map("storage_key")
  uploadedBy  String         @map("uploaded_by") @db.Uuid
  /// Logical delete (§1.1.8): the row is kept and the removal is audited.
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  company  Company @relation(fields: [companyId], references: [id])
  order    Order   @relation(fields: [orderId], references: [id])
  uploader User    @relation("FileUploadedBy", fields: [uploadedBy], references: [id])

  @@index([orderId])
  @@index([targetType, targetId])
  @@index([companyId, createdAt])
  @@map("file_objects")
}

/// Share of a property's history with a concrete membership (spec §2.8, §7.5).
/// Active-share uniqueness is enforced in the application (409).
model HistoryShare {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  propertyId             String    @map("property_id") @db.Uuid
  sharedWithMembershipId String    @map("shared_with_membership_id") @db.Uuid
  sharedBy               String    @map("shared_by") @db.Uuid
  /// Why / which relevant antecedents (§7.5).
  note                   String?
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  company              Company    @relation(fields: [companyId], references: [id])
  property             Property   @relation(fields: [propertyId], references: [id])
  sharedWithMembership Membership @relation("HistoryShareRecipient", fields: [sharedWithMembershipId], references: [id])
  sharedByUser         User       @relation("HistoryShareCreatedBy", fields: [sharedBy], references: [id])

  @@index([propertyId, sharedWithMembershipId])
  @@index([companyId])
  @@map("history_shares")
}

// ---------------------------------------------------------------------------
// Etapa 4: costos, autorizaciones y relación comercial
// (docs/especificacion/etapa-4.md §2.4–§2.8)
// ---------------------------------------------------------------------------

/// Real commercial relation (company↔company or professional↔own client) that
/// can override the company's general emergency policy (spec etapa-4 §2.4,
/// §8.6). Rows are created by the company whose orders they govern (role
/// `owner`, decision 7); the counterparty doesn't confirm in v1. `endedAt`
/// prevents attaching to new orders; existing orders keep their reference.
model CommercialRelation {
  id                    String           @id @default(uuid()) @db.Uuid
  companyId             String           @map("company_id") @db.Uuid
  counterpartyCompanyId String?          @map("counterparty_company_id") @db.Uuid
  clientRelationshipId  String?          @map("client_relationship_id") @db.Uuid
  label                 String?
  /// Emergency-policy override; null = the company's general policy applies.
  emergencyPolicy       EmergencyPolicy? @map("emergency_policy")
  emergencyExtraAmount  Decimal?         @map("emergency_extra_amount") @db.Decimal(12, 2)
  endedAt               DateTime?        @map("ended_at") @db.Timestamptz()
  createdBy             String           @map("created_by") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  company             Company             @relation("CommercialRelationOwner", fields: [companyId], references: [id])
  counterpartyCompany Company?            @relation("CommercialRelationCounterparty", fields: [counterpartyCompanyId], references: [id])
  clientRelationship  ClientRelationship? @relation(fields: [clientRelationshipId], references: [id])
  createdByUser       User                @relation("CommercialRelationCreatedBy", fields: [createdBy], references: [id])
  orders              Order[]

  @@unique([companyId, counterpartyCompanyId])
  @@unique([companyId, clientRelationshipId])
  @@index([companyId])
  @@map("commercial_relations")
}

/// Versioned cost report of one assignment (the commercial relation that
/// emits costs, spec etapa-4 §2.5, §8.1–§8.3): one editable `draft` at most
/// and any number of immutable `submitted` versions. Corrections open the
/// next version linked to the previous one (§8.2).
model CostReport {
  id               String           @id @default(uuid()) @db.Uuid
  assignmentId     String           @map("assignment_id") @db.Uuid
  /// Emitter = the company of the assignee membership (§2.5, decision 3).
  companyId        String           @map("company_id") @db.Uuid
  version          Int
  status           CostReportStatus @default(draft)
  notes            String?
  /// Sum of the items, computed on submit; null while in draft.
  total            Decimal?         @db.Decimal(12, 2)
  submittedBy      String?          @map("submitted_by") @db.Uuid
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz()
  previousReportId String?          @map("previous_report_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  assignment      Assignment   @relation(fields: [assignmentId], references: [id])
  company         Company      @relation(fields: [companyId], references: [id])
  submittedByUser User?        @relation("CostReportSubmittedBy", fields: [submittedBy], references: [id])
  previousReport  CostReport?  @relation("CostReportPrevious", fields: [previousReportId], references: [id])
  nextReports     CostReport[] @relation("CostReportPrevious")
  items           CostItem[]

  @@unique([assignmentId, version])
  @@index([assignmentId, status])
  @@index([companyId])
  @@map("cost_reports")
}

/// Cost line of a report (spec etapa-4 §2.6, §8.1). Editable only while the
/// report is in draft; the server enforces it (§16.1).
model CostItem {
  id           String       @id @default(uuid()) @db.Uuid
  costReportId String       @map("cost_report_id") @db.Uuid
  category     CostCategory
  description  String
  amount       Decimal      @db.Decimal(12, 2)
  /// Registered inside an emergency intervention (§8.6); compared against
  /// the pre-authorized emergency amount in the economic summary.
  isEmergency  Boolean      @default(false) @map("is_emergency")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  costReport CostReport @relation(fields: [costReportId], references: [id])

  @@index([costReportId])
  @@map("cost_items")
}

/// Append-only ledger of economic authorizations of an order (spec etapa-4
/// §2.7, §8.4, §8.7, §18.1): platform approvals and off-platform records
/// (telephone). The app role has no UPDATE/DELETE grants (migration
/// etapa4_order_authorizations_grants, §7). A record never rewrites costs or
/// states by itself; it is the «quién autorizó, cuándo, qué» evidence.
model OrderAuthorization {
  id                     String                   @id @default(uuid()) @db.Uuid
  orderId                String                   @map("order_id") @db.Uuid
  type                   AuthorizationRequestType
  source                 AuthorizationSource
  /// Approver in the platform; null for off-platform records (§18.1).
  grantedByUserId        String?                  @map("granted_by_user_id") @db.Uuid
  /// Name/role of who granted it (required for `offline`, §18.1).
  grantedByDescription   String?                  @map("granted_by_description")
  grantedAt              DateTime                 @map("granted_at") @db.Timestamptz()
  /// Who registered the record (in `offline`, the member who wrote it down).
  authorizedByUserId     String                   @map("authorized_by_user_id") @db.Uuid
  /// For `exceed_spending_limit`: additional amount authorized on top of the
  /// effective spending limit (§8.4).
  amountCap              Decimal?                 @map("amount_cap") @db.Decimal(12, 2)
  description            String
  /// At most one authorization per originating request (1-1, §4.4).
  authorizationRequestId String?                  @unique @map("authorization_request_id") @db.Uuid
  /// Job created by approving an `additional_work` request (§8.4, §9).
  jobId                  String?                  @map("job_id") @db.Uuid
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz()

  order                Order                 @relation(fields: [orderId], references: [id])
  grantedByUser        User?                 @relation("OrderAuthorizationGrantedBy", fields: [grantedByUserId], references: [id])
  authorizedByUser     User                  @relation("OrderAuthorizationAuthorizedBy", fields: [authorizedByUserId], references: [id])
  authorizationRequest AuthorizationRequest? @relation("AuthorizationForRequest", fields: [authorizationRequestId], references: [id])
  job                  Job?                  @relation(fields: [jobId], references: [id])
  createdFromRequest   AuthorizationRequest? @relation("AuthorizationFromRequest")

  @@index([orderId])
  @@map("order_authorizations")
}

/// Authorization request raised by an assignee company and resolved only by
/// the originating company (spec etapa-4 §2.8, §8.4, §9, §14.1).
model AuthorizationRequest {
  id                  String                     @id @default(uuid()) @db.Uuid
  orderId             String                     @map("order_id") @db.Uuid
  requestingCompanyId String                     @map("requesting_company_id") @db.Uuid
  requestedByUserId   String                     @map("requested_by_user_id") @db.Uuid
  type                AuthorizationRequestType
  description         String
  requestedAmount     Decimal?                   @map("requested_amount") @db.Decimal(12, 2)
  status              AuthorizationRequestStatus @default(pending)
  resolvedByUserId    String?                    @map("resolved_by_user_id") @db.Uuid
  resolvedAt          DateTime?                  @map("resolved_at") @db.Timestamptz()
  /// Mandatory when rejecting (§9).
  resolutionNote      String?                    @map("resolution_note")
  /// At most one authorization is created from a request (1-1, §4.4).
  authorizationId     String?                    @unique @map("authorization_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz()

  order             Order                @relation(fields: [orderId], references: [id])
  requestingCompany Company              @relation("AuthRequestCompany", fields: [requestingCompanyId], references: [id])
  requestedByUser   User                 @relation("AuthRequestRequestedBy", fields: [requestedByUserId], references: [id])
  resolvedByUser    User?                @relation("AuthRequestResolvedBy", fields: [resolvedByUserId], references: [id])
  authorization     OrderAuthorization?  @relation("AuthorizationFromRequest", fields: [authorizationId], references: [id])
  authorizations    OrderAuthorization[] @relation("AuthorizationForRequest")

  @@index([orderId, status])
  @@index([requestingCompanyId])
  @@map("authorization_requests")
}

// ---------------------------------------------------------------------------
// Etapa 5 (docs/especificacion/etapa-5.md §2.2–§2.5)
// ---------------------------------------------------------------------------

/// Formal invoice (spec etapa-5 §2.2, proyect.md §11.1–§11.6). Drafts are
/// editable; an emitted invoice is immutable except for payment transitions
/// and voiding (§11.5). Money never leaves cents arithmetic in the app and is
/// stored as Decimal(12,2) — never Float (§12). Exactly one recipient:
/// `recipient_company_id XOR recipient_tenant_id` (enforced by CHECK).
model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  /// Issuer (tenant-scoped owner of the row, §16.2).
  companyId          String        @map("company_id") @db.Uuid
  /// Recipient company (contractor→admin, professional→contractor, §11.3).
  recipientCompanyId String?       @map("recipient_company_id") @db.Uuid
  /// Recipient client for own-business orders (decisión P3, D1b).
  recipientTenantId  String?       @map("recipient_tenant_id") @db.Uuid
  /// v1: one invoice = one order (D8).
  orderId            String        @map("order_id") @db.Uuid
  status             InvoiceStatus @default(draft)
  /// Per-company sequential number, assigned only on emission (D2); unique
  /// together with the issuer, no gaps — voided invoices keep theirs (§11.5).
  number             Int?
  issueDate          DateTime?     @map("issue_date") @db.Date
  /// Emission date + 30 days when not set (D3).
  dueDate            DateTime?     @map("due_date") @db.Date
  /// Frozen totals snapshot taken at emission (D5); null while draft.
  subtotal           Decimal?      @db.Decimal(12, 2)
  /// Etapa 7 (etapa-7.md §2.2, §11.6): rate applied and tax frozen at
  /// emission (invoice override ?? company default); null while draft and on
  /// pre-etapa-7 invoices (backfilled with tax_total = 0.00).
  taxRate            Decimal?      @map("tax_rate") @db.Decimal(5, 3)
  taxTotal           Decimal?      @map("tax_total") @db.Decimal(12, 2)
  total              Decimal?      @db.Decimal(12, 2)
  notes              String?
  voidedAt           DateTime?     @map("voided_at") @db.Timestamptz()
  voidReason         String?       @map("void_reason")
  voidedById         String?       @map("voided_by") @db.Uuid
  createdById        String        @map("created_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  company          Company       @relation("InvoiceIssuer", fields: [companyId], references: [id])
  recipientCompany Company?      @relation("InvoiceRecipientCompany", fields: [recipientCompanyId], references: [id])
  recipientTenant  Tenant?       @relation("InvoiceRecipientTenant", fields: [recipientTenantId], references: [id])
  order            Order         @relation(fields: [orderId], references: [id])
  voidedBy         User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  createdBy        User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  lines            InvoiceLine[]
  payments         Payment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([recipientCompanyId])
  @@index([recipientTenantId])
  @@index([orderId])
  @@index([status])
  @@map("invoices")
}

/// Invoice line item (spec etapa-5 §2.3, proyect.md §11.1): every line
/// references the job it comes from, restricted to jobs the issuer may bill
/// (D1a/D1b).
model InvoiceLine {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  kind        InvoiceLineKind
  description String
  /// ≥ 0; the invoice total is the sum of lines (CHECK).
  amount      Decimal         @db.Decimal(12, 2)
  /// Etapa 7 (etapa-7.md §2.3, T4): taxable by default; the issuer removes
  /// the flag per line (§11.6 — no hardcoded rules by party types).
  taxable     Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  job     Job     @relation(fields: [jobId], references: [id])

  @@index([invoiceId])
  @@index([jobId])
  @@map("invoice_lines")
}

/// Payment or refund against an invoice (spec etapa-5 §2.4, proyect.md §11.1,
/// §12). Never deleted: suspected duplicates are kept and reconciled, never
/// silently removed (§1.1.8, §11.1). Only the reconciliation fields change
/// after creation, via the reconcile endpoint.
model Payment {
  id                 String         @id @default(uuid()) @db.Uuid
  /// Registrant company; must be the invoice's issuer or recipient (§11.1).
  companyId          String         @map("company_id") @db.Uuid
  invoiceId          String         @map("invoice_id") @db.Uuid
  kind               PaymentKind    @default(charge)
  /// `recorded` counts toward the balance; `duplicate_*` do not (D6).
  status             PaymentStatus  @default(recorded)
  /// Canonical payment this one was flagged as a possible duplicate of (D6).
  duplicateOfId      String?        @map("duplicate_of_id") @db.Uuid
  /// > 0 (CHECK). Refunds subtract from the net paid (D7).
  amount             Decimal        @db.Decimal(12, 2)
  /// Date of the payment operation; never in the future (422, D7).
  paidAt             DateTime       @map("paid_at") @db.Date
  method             PaymentMethod?
  /// Reference or receipt — part of the duplicate comparison (D6).
  reference          String?
  notes              String?
  /// Reconciliation constancy (§11.1): who resolved it and when.
  reconciledByUserId String?        @map("reconciled_by_user_id") @db.Uuid
  reconciledAt       DateTime?      @map("reconciled_at") @db.Timestamptz()
  createdById        String         @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  company      Company   @relation("PaymentCompany", fields: [companyId], references: [id])
  invoice      Invoice   @relation(fields: [invoiceId], references: [id])
  duplicateOf  Payment?  @relation("PaymentDuplicateOf", fields: [duplicateOfId], references: [id])
  duplicates   Payment[] @relation("PaymentDuplicateOf")
  reconciledBy User?     @relation("PaymentReconciledBy", fields: [reconciledByUserId], references: [id])
  createdBy    User      @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([companyId])
  @@index([status])
  @@map("payments")
}

/// Per-company invoice number sequence (spec etapa-5 §2.5, D2): the row is
/// locked with SELECT … FOR UPDATE inside the emission transaction so the
/// series never skips a number, even under concurrency.
model InvoiceCounter {
  companyId  String @id @map("company_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  company Company @relation(fields: [companyId], references: [id])

  @@map("invoice_counters")
}

// ---------------------------------------------------------------------------
// Etapa 6 models (docs/especificacion/etapa-6.md §2)
// ---------------------------------------------------------------------------

/// Reclamo de garantía sobre un trabajo reparado (§13). La empresa
/// originadora de la orden original lo inicia y gestiona en su propio
/// espacio (D5); para el resto de empresas es invisible (404). El
/// historial de la reparación no se duplica: fechas, profesional, costos,
/// fotos y documentos se conservan enlazando la orden, el trabajo, los
/// costos y los archivos ya existentes (etapa-6.md §2.1).
model WarrantyClaim {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  orderId          String              @map("order_id") @db.Uuid
  jobId            String              @map("job_id") @db.Uuid
  description      String
  status           WarrantyClaimStatus @default(open)
  resolution       String?
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz()
  resolvedByUserId String?             @map("resolved_by_user_id") @db.Uuid
  createdBy        String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  company        Company @relation(fields: [companyId], references: [id])
  order          Order   @relation(fields: [orderId], references: [id])
  job            Job     @relation(fields: [jobId], references: [id])
  resolvedByUser User?   @relation("WarrantyClaimResolvedBy", fields: [resolvedByUserId], references: [id])
  createdByUser  User    @relation("WarrantyClaimCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([companyId, orderId])
  @@index([jobId])
  @@map("warranty_claims")
}

/// Plan de suscripción por categoría (§15, §18.3). Precios de ejemplo
/// 33/66/99 USD al mes, ajustables por semilla/despliegue (D4); sin
/// límites de uso ni funciones diferenciadas en la v1 y la cobranza
/// queda fuera del sistema (§18.3). Un solo plan por categoría.
model Plan {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  category  PlanCategory @unique
  price     Decimal      @db.Decimal(12, 2)
  currency  String       @default("USD")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  companies Company[]

  @@map("plans")
}

/// Preferencia de correo por usuario y tipo de aviso (§18.4). El in-app
/// nunca se apaga; ausencia de fila = correo encendido (default §18.4).
/// `type` es un string validado en la capa de servicio contra el conjunto
/// cerrado de avisos (etapa-6.md §2.6): los tipos de NotificationType más
/// los correos de negocio (costos, autorizaciones, facturación — D6).
model NotificationPreference {
  userId       String   @map("user_id") @db.Uuid
  type         String
  emailEnabled Boolean  @default(true) @map("email_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@id([userId, type])
  @@map("notification_preferences")
}
