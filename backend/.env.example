# Copiar a .env — credenciales de desarrollo local (docker-compose.yml)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Migraciones (Prisma CLI): rol con privilegios de creación (dev)
DATABASE_URL="postgresql://dev:dev@localhost:5432/home_management?schema=public"
# Runtime de la app: rol restringido (no puede UPDATE/DELETE sobre audit_log)
APP_DATABASE_URL="postgresql://app:app_dev@localhost:5432/home_management?schema=public"

# Email transaccional — 'console' imprime los emails en el log (dev/test)
# Para Resend: EMAIL_TRANSPORT=resend + API key (y dominio verificado para producción)
EMAIL_TRANSPORT=console
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="no-reply@tudominio.com"
#
# Buzón de prueba (solo dev/CI, frontend spec F1-D4/§12): con transporte console,
# además del log enmascarado, cada email se adjunta completo (JSONL) en este
# archivo para que los e2e puedan seguir los links. Prohibido en producción.
# EMAIL_OUTBOX_FILE=/tmp/hm-email-outbox.jsonl
#
# Sandbox de Resend (sin verificar dominio): se envía desde onboarding@resend.dev
# y SOLO puede entregarse a la email de tu propia cuenta Resend o a las de prueba
# (delivered@resend.dev, bounced@resend.dev, complained@resend.dev). El destinatario
# debe ir sin nombre visible. Para enviar a usuarios reales: verificar un dominio propio.
# EMAIL_FROM="Home Management <onboarding@resend.dev>"

# Base del frontend para armar los links de email (invitaciones, reset)
FRONTEND_URL=http://localhost:3000
